# ============================================================
#                    VARIABLES DE ENTORNO
# ============================================================

# --- PostgreSQL Local (Base Maestra) ---
DATABASE_URL=postgresql+psycopg://db_user:password@localhost:5432/db_name

# --- Supabase ---
SUPABASE_URL=postgresql+psycopg://postgres:password@db.<project>.supabase.co:5432/postgres?sslmode=require
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_PROJECT_URL=https://<project>.supabase.co

# --- FastAPI ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=supersecretkey_change_in_production
APP_DEBUG=true

# --- Mockoon (API Mercado Libre simulada) ---
MOCKOON_URL=http://localhost:3001
MOCKOON_ENDPOINT=/api/vendedor/{id}

# --- Metabase Local ---
METABASE_URL=http://localhost:3000
METABASE_USER=user_email_here
METABASE_PASSWORD=user_password_here
